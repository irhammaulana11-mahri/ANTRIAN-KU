[Unit]
Description=SQMS Laravel Reverb WebSocket Server
After=network.target redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/sqms/backend
ExecStart=/usr/bin/php /var/www/sqms/backend/artisan reverb:start --host=0.0.0.0 --port=8080
Restart=always
RestartSec=5
StandardOutput=append:/var/log/sqms-reverb.log
StandardError=append:/var/log/sqms-reverb-error.log
Environment=APP_ENV=production

[Install]
WantedBy=multi-user.target
