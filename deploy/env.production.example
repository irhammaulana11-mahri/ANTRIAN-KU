# Contoh backend/.env untuk server produksi (diselaraskan dengan server ULP Jombang). Salin ke backend/.env lalu ISI nilai kosong.
# Jangan commit .env. Jangan memakai nilai contoh/lokal untuk secret.
APP_NAME=SQMS
APP_ENV=production
APP_KEY=                       # php artisan key:generate (sekali saja; jangan diganti setelah ada data)
APP_DEBUG=false
APP_URL=http://10.5.119.251:8081   # alamat yang dipakai pengguna; ganti ke https://domain bila TLS terpasang
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=antrian_db
DB_USERNAME=antrian_user
DB_PASSWORD=                   # password kuat, dari secret store

# Cache, queue, dan sesi memakai tabel database (tidak butuh Redis). Worker supervisor harus memakai koneksi yang sama
# (deploy/supervisor/antrian-ku.conf: queue:work database). Bila pindah ke Redis, ubah keduanya sekaligus.
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# Frontend dilayani Nginx dari host yang sama, jadi CORS hanya perlu bila ada origin lain (mis. dev server).
CORS_ALLOWED_ORIGINS=
SANCTUM_STATEFUL_DOMAINS=
# SANCTUM_STAFF_TOKEN_MINUTES=720

# Reverb (WebSocket) dijalankan Supervisor di 127.0.0.1:8080 dan diproksikan Nginx lewat /app/.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=antrian-ku
REVERB_APP_KEY=                # acak, min. 32 karakter (jangan pakai nilai "local")
REVERB_APP_SECRET=             # acak, min. 32 karakter
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Host/IP yang membuka aplikasi (browser operator, TV, kiosk), tanpa skema. Pisahkan koma.
REVERB_ALLOWED_ORIGINS=10.5.119.251,antrian-ku.bolinggo.org

# Akun Super Admin awal (dibuat seeder). Ganti password setelah login pertama.
SQMS_ADMIN_EMAIL=
SQMS_ADMIN_PASSWORD=
SQMS_ADMIN_NAME=

# Swagger UI di /api/docs (default: nonaktif saat APP_ENV=production)
# API_DOCS_ENABLED=false
