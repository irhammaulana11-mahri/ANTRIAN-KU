APP_NAME=SQMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Jakarta

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=antrian_db
DB_USERNAME=sqms
DB_PASSWORD=123456

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=sqms
REVERB_APP_KEY=sqms-local-key
REVERB_APP_SECRET=sqms-local-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# Swagger UI di /api/docs (default: aktif kecuali APP_ENV=production)
# API_DOCS_ENABLED=true

# Masa berlaku token staf/admin (menit). Frontend memperpanjang otomatis selama tab terbuka.
# SANCTUM_STAFF_TOKEN_MINUTES=720
